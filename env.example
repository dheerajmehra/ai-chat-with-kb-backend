# Application Settings
APP_NAME=DFSA RAG Ingestion Pipeline
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# PDF Processing Library (required)
# Choose: pdfplumber (default, works everywhere) or pymupdf (faster, may need special install)
PDF_LIBRARY=pdfplumber

# Vector Store Configuration
# Options: azure, openai, local, file
# - local: In-memory (single process only)
# - file: File-based (can be shared between processes)
VECTOR_STORE_TYPE=file
VECTOR_STORE_PATH=data/vector_store.pkl
EMBEDDING_PROVIDER=sentence-transformers  # Options: openai, azure, sentence-transformers

# Azure AI Search Configuration
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_KEY=your-search-key
AZURE_SEARCH_INDEX_NAME=dfsa-rulebooks

# Azure OpenAI Configuration (if using Azure embeddings)
AZURE_OPENAI_ENDPOINT=https://your-openai-service.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=text-embedding-ada-002

# OpenAI Configuration (if using OpenAI directly)
OPENAI_API_KEY=your-openai-key
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# LLM Configuration (for generating chat responses)
# Set LLM_ENABLED=true to enable LLM-based responses (requires OPENAI_API_KEY)
LLM_ENABLED=false
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.7
# Optional: Custom system prompt (leave empty to use default)
# LLM_SYSTEM_PROMPT=Your custom system prompt here

# Sentence Transformers Configuration (if using local embeddings)
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RESPECT_SENTENCE_BOUNDARIES=true
RESPECT_SECTION_BOUNDARIES=true

# Processing Configuration
MAX_FILE_SIZE_MB=50
SUPPORTED_FILE_TYPES=pdf
BACKGROUND_TASK_TIMEOUT=3600

